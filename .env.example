# --- Host port mappings (change if these are taken on your machine) ---
WEB_PORT=3000
DB_PORT=3306

# --- TinyMCE Cloud (rich-text comments) ---
# Get a key at https://www.tiny.cloud/ and add your app domain to its allow-list.
# This is a NEXT_PUBLIC_ var: it is inlined into the client bundle at BUILD time,
# so you must rebuild the web image after changing it (docker compose up --build).
NEXT_PUBLIC_TINYMCE_API_KEY=your-tinymce-cloud-api-key

# --- Database ---
# Inside docker-compose the host is "mysql"; for local dev/CLI use 127.0.0.1:${DB_PORT}
DATABASE_URL="mysql://crm:crm@127.0.0.1:3306/crm"
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=crm
MYSQL_USER=crm
MYSQL_PASSWORD=crm

# --- Auth / sessions ---
# 32+ char random secret used to sign session JWTs
AUTH_SECRET="change-me-to-a-long-random-string-please-32+"
SESSION_COOKIE_NAME="crm_session"

# --- WebAuthn / Passkeys ---
# RP ID must match the domain (no protocol/port). Use "localhost" for dev.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="CRM"
# Full origin including protocol and port
WEBAUTHN_ORIGIN="http://localhost:3000"

# --- File storage (local volume) ---
UPLOADS_DIR="/data/uploads"

# --- Bootstrap admin (created by seed) ---
SEED_ADMIN_EMAIL="admin@crm.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Transactional email (Postmark) ---
# When POSTMARK_API_KEY or EMAIL_FROM is empty, email sending is a no-op (dev).
POSTMARK_API_KEY=
EMAIL_FROM=
POSTMARK_MESSAGE_STREAM=outbound
# Base URL used to build links in notification emails.
APP_BASE_URL=http://localhost:3007

# --- Daily priorities digest (cron) ---
# Sends every enabled user a 03:00 UTC email with their overdue/today tasks,
# overdue + soon-closing deals, and a table of neglected deals. The endpoint
# (/api/cron/daily-digest) is guarded by a shared secret managed in
# Admin -> Settings (DB-backed). As a fallback it also accepts this env var,
# which is what Vercel Cron sends automatically as `Authorization: Bearer`.
# Leave empty to rely solely on the Admin -> Settings secret.
CRON_SECRET=
# Schedule it once a day at 03:00 UTC. On Vercel this is wired via vercel.json.
# On a Docker/VPS host, add a crontab entry such as:
#   0 3 * * * curl -fsS -X POST -H "x-webhook-secret: <secret>" https://your-app/api/cron/daily-digest

# --- Inbound invoice webhook + OpenAI extraction ---
# The invoice webhook shared secret is managed in Admin -> Settings (DB-backed),
# the same way as the inbound-email webhook. Mirror it in the Gmail Apps Script.
# OpenAI API key + model used to extract number/total/date from returned PDFs.
# When OPENAI_API_KEY is empty, extraction is skipped (files are still stored).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
