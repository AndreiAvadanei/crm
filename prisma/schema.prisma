// CRM data model. All schema changes are applied via `prisma migrate`.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------
enum Role {
  ADMIN
  SALES
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TaskType {
  TASK
  CALL
  NOTE
  MEETING
  EMAIL
}

enum TaskStatus {
  OPEN
  DONE
}

// Declared low -> high so `orderBy: { urgency: "desc" }` surfaces CRITICAL first
// (Prisma/MySQL sort enums by declaration order).
enum TaskUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomEntity {
  DEAL
  CLIENT
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
  URL
}

enum ShareSubject {
  DEAL
  CLIENT
}

enum InvoiceStatus {
  GENERATA
  TRIMISA_LA_CONTABILITATE
  IN_ASTEPTARE
  OTHER
}

// ---------------------------------------------------------------------------
// Users / auth
// ---------------------------------------------------------------------------
model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String
  passwordHash       String
  role               Role       @default(SALES)
  status             UserStatus @default(ACTIVE)
  avatarColor        String     @default("#6366f1")
  // Force a password change on first login.
  mustChangePassword Boolean    @default(true)
  // 2FA is mandatory; this flips true once TOTP or a passkey is enrolled.
  twoFactorEnabled   Boolean    @default(false)
  totpSecret         String?
  // Default lower bound for which deals/clients a sales user can see by creation date.
  visibleFrom        DateTime?
  // Transient WebAuthn challenge used during passkey enrollment.
  currentChallenge   String?    @db.Text
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions       Session[]
  credentials    WebAuthnCredential[]
  ownedDeals     Deal[]               @relation("DealOwner")
  ownedClients   Client[]             @relation("ClientOwner")
  assignedTasks  Task[]               @relation("TaskAssignee")
  comments       Comment[]
  attachments    Attachment[]
  shares         Share[]
  accessRules    AccessRule[]
  auditLogs      AuditLog[]
  jiraAccountIds JiraUserMap[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Random opaque token stored (hashed) and referenced by the session cookie.
  tokenHash    String   @unique
  twoFactorOk  Boolean  @default(false)
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model WebAuthnCredential {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId  String   @unique
  publicKey     Bytes
  counter       BigInt   @default(0)
  transports    String?
  deviceName    String   @default("Passkey")
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?

  @@index([userId])
}

// Maps Jira accountIds (from CSV) to CRM users for import attribution.
model JiraUserMap {
  id          String  @id @default(cuid())
  jiraAccount String  @unique
  displayName String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Pipeline / stages / tags
// ---------------------------------------------------------------------------
model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  order     Int      @default(0)
  stages    Stage[]
  deals     Deal[]
  createdAt DateTime @default(now())
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)
  color      String   @default("#64748b")
  // Grouping band on the board, e.g. "Lead" | "Active" | "Closing" | "Won" | "Lost".
  phase      String?
  // Probability used for weighted forecast (0-100).
  probability Int     @default(0)
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  deals      Deal[]

  @@index([pipelineId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  deals     Deal[]   @relation("DealTags")
  clients   Client[] @relation("ClientTags")
  accessRules AccessRule[]
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Clients & deals
// ---------------------------------------------------------------------------
model Client {
  id            String   @id @default(cuid())
  name          String
  website       String?
  country       String?
  size          String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  ownerId       String?
  owner         User?    @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags          Tag[]    @relation("ClientTags")
  deals         Deal[]
  organizations Organization[]
  invoices      Invoice[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
  @@index([createdAt])
}

model Deal {
  id          String    @id @default(cuid())
  salesId     String    @unique // e.g. SAL-1234
  title       String
  description String?   @db.Text
  amountEur   Decimal?  @db.Decimal(14, 2)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pipelineId  String
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id])
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id])
  ownerId     String?
  owner       User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Manual ordering within a kanban column.
  boardOrder  Int       @default(0)
  dueDate     DateTime?
  closedAt    DateTime?
  tags        Tag[]     @relation("DealTags")
  tasks       Task[]
  comments    Comment[]
  attachments Attachment[]
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
  @@index([ownerId])
  @@index([stageId])
  @@index([createdAt])
}

model Task {
  id          String     @id @default(cuid())
  dealId      String
  deal        Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title       String
  type        TaskType    @default(TASK)
  status      TaskStatus  @default(OPEN)
  urgency     TaskUrgency @default(MEDIUM)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([dealId])
  @@index([assigneeId])
  @@index([status])
  @@index([urgency])
}

model Comment {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  notifiedUserIds Json? // user ids explicitly notified for this comment, used to pre-select next time
  createdAt DateTime @default(now())

  @@index([dealId])
}

model Attachment {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  filename     String
  storageKey   String   // relative path inside UPLOADS_DIR
  size         Int      @default(0)
  mimeType     String?
  sourceUrl    String?  @db.Text // original Jira URL when imported
  // Inline images pasted/uploaded inside rich-text (comments). Kept out of the
  // Files list UI but served through the same access-checked attachments route.
  inline       Boolean  @default(false)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([dealId])
}

// ---------------------------------------------------------------------------
// Billing: organizations (legal entities) & invoices
// ---------------------------------------------------------------------------
// A billing legal entity (SRL/SA/LLC/etc.) that we issue invoices to. One CRM
// Client (the account/relationship) can own several Organizations.
model Organization {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Exact name as it appears in the source export ("Nume companie"). Used as the
  // idempotent join key for the invoice import (facturi "Nume companie (from Client)").
  sourceName String   @unique
  // Display/legal name (defaults to sourceName when not separately provided).
  legalName  String?
  country    String?
  // Romanian CUI / VAT id / EIN etc.
  taxId      String?
  // Romanian trade-register number ("J....").
  regNumber  String?
  bankName   String?
  iban       String?
  address    String?  @db.Text
  // Marks the default billing entity for its client.
  isDefault  Boolean  @default(false)
  invoices   Invoice[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@index([taxId])
}

model Invoice {
  id             String        @id @default(cuid())
  // Source idempotency key: Airtable "Record ID" for imports, "manual-<cuid>" for
  // records created through the UI. Unique so re-imports update in place.
  externalRecordId String      @unique
  // Original request reference from the source export ("Referinta cerere").
  externalRef    String?
  // Human invoice number(s), e.g. "BT.BIT 696".
  number         String?
  status         InvoiceStatus @default(GENERATA)

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Denormalized owning client for convenient listing/filtering.
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Opportunity this invoice was issued under (via Deal.salesId). Nullable because
  // some invoices reference a SAL that is missing from the CRM, or none at all.
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  // Snapshot of the referenced SAL id (kept even when the deal can't be resolved).
  salesIdSnapshot String?

  servicesDescription String?   @db.Text
  // Best-effort contract reference parsed from the services text.
  contractRef    String?
  // Raw amount string from the source ("Suma"), kept verbatim for traceability.
  amountRaw      String?
  currency       String?
  paymentTermDays Int?
  issueDate      DateTime?
  // Date the invoice is expected/planned to be issued (manual scheduling).
  expectedInvoiceDate DateTime?
  // Parsed numeric total of the invoice.
  totalAmount    Decimal?      @db.Decimal(14, 2)
  // Raw total string ("Total de pe factura"), kept verbatim.
  totalRaw       String?
  // Newline-separated source document URLs ("Facturi").
  fileUrls       String?       @db.Text
  // Issuing company ("Factura se face pe"), typically the seller entity.
  issuerName     String?
  createdByName  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([dealId])
  @@index([clientId])
  @@index([issueDate])
}

// ---------------------------------------------------------------------------
// Custom fields (admin configurable)
// ---------------------------------------------------------------------------
model CustomFieldDefinition {
  id        String          @id @default(cuid())
  entity    CustomEntity
  key       String // stable machine key, unique per entity
  label     String
  type      CustomFieldType @default(TEXT)
  options   Json? // for SELECT / MULTISELECT
  required  Boolean         @default(false)
  order     Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  values    CustomFieldValue[]

  @@unique([entity, key])
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entity       CustomEntity
  entityId     String
  value        Json?
  updatedAt    DateTime              @updatedAt

  @@unique([definitionId, entityId])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------
// Explicit share of a single deal/client to a user (admin granted).
model Share {
  id        String       @id @default(cuid())
  subject   ShareSubject
  subjectId String
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([subject, subjectId, userId])
  @@index([userId])
}

// Tag + date based visibility rule for a sales user.
model AccessRule {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null tag = applies to all tags (still bounded by visibleFrom)
  tagId       String?
  tag         Tag?      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  visibleFrom DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Sequence counters (e.g. SAL deal numbers).
model Counter {
  name  String @id
  value Int    @default(0)
}

// Generic app-level key/value settings (admin configurable, single-tenant).
// e.g. key="default_deal_owner_id" -> value=<userId>.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Audit + idempotency log for inbound lead emails received via webhook.
// `messageId` (e.g. the Gmail message id) is unique so retried/duplicate
// deliveries are recognized and skipped instead of creating duplicate deals.
model InboundLead {
  id        String   @id @default(cuid())
  messageId String   @unique
  fromAddr  String?
  subject   String?
  status    String // "created" | "duplicate" | "ignored" | "error"
  dealId    String?
  clientId  String?
  error     String?  @db.Text
  payload   String   @db.Text // raw JSON body as received
  createdAt DateTime @default(now())

  @@index([createdAt])
}
