// CRM data model. All schema changes are applied via `prisma migrate`.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------
enum Role {
  ADMIN
  SALES
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TaskType {
  TASK
  CALL
  NOTE
  MEETING
  EMAIL
}

enum TaskStatus {
  OPEN
  DONE
}

// Declared low -> high so `orderBy: { urgency: "desc" }` surfaces CRITICAL first
// (Prisma/MySQL sort enums by declaration order).
enum TaskUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomEntity {
  DEAL
  CLIENT
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
  URL
}

enum ShareSubject {
  DEAL
  CLIENT
}

enum InvoiceStatus {
  GENERATA
  TRIMISA_LA_CONTABILITATE
  IN_ASTEPTARE
  OTHER
}

// ---------------------------------------------------------------------------
// Users / auth
// ---------------------------------------------------------------------------
model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String
  passwordHash       String
  role               Role       @default(SALES)
  status             UserStatus @default(ACTIVE)
  avatarColor        String     @default("#6366f1")
  // Force a password change on first login.
  mustChangePassword Boolean    @default(true)
  // 2FA is mandatory; this flips true once TOTP or a passkey is enrolled.
  twoFactorEnabled   Boolean    @default(false)
  totpSecret         String?
  // Default lower bound for which deals/clients a sales user can see by creation date.
  visibleFrom        DateTime?
  // Lower bound (by invoice issue date) for invoices a sales user may see,
  // independent of whether they can see the owning client.
  invoiceVisibleFrom DateTime?
  // Transient WebAuthn challenge used during passkey enrollment.
  currentChallenge   String?    @db.Text
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions       Session[]
  credentials    WebAuthnCredential[]
  ownedDeals     Deal[]               @relation("DealOwner")
  ownedClients   Client[]             @relation("ClientOwner")
  assignedTasks  Task[]               @relation("TaskAssignee")
  comments       Comment[]
  attachments    Attachment[]
  shares         Share[]
  accessRules    AccessRule[]
  auditLogs      AuditLog[]
  jiraAccountIds JiraUserMap[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Random opaque token stored (hashed) and referenced by the session cookie.
  tokenHash    String   @unique
  twoFactorOk  Boolean  @default(false)
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model WebAuthnCredential {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId  String   @unique
  publicKey     Bytes
  counter       BigInt   @default(0)
  transports    String?
  deviceName    String   @default("Passkey")
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?

  @@index([userId])
}

// Maps Jira accountIds (from CSV) to CRM users for import attribution.
model JiraUserMap {
  id          String  @id @default(cuid())
  jiraAccount String  @unique
  displayName String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Pipeline / stages / tags
// ---------------------------------------------------------------------------
model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  order     Int      @default(0)
  stages    Stage[]
  deals     Deal[]
  createdAt DateTime @default(now())
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)
  color      String   @default("#64748b")
  // Grouping band on the board, e.g. "Lead" | "Active" | "Closing" | "Won" | "Lost".
  phase      String?
  // Probability used for weighted forecast (0-100).
  probability Int     @default(0)
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  deals      Deal[]

  @@index([pipelineId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  deals     Deal[]   @relation("DealTags")
  clients   Client[] @relation("ClientTags")
  accessRules AccessRule[]
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Clients & deals
// ---------------------------------------------------------------------------
model Client {
  id            String   @id @default(cuid())
  name          String
  website       String?
  country       String?
  size          String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  ownerId       String?
  owner         User?    @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags          Tag[]    @relation("ClientTags")
  deals         Deal[]
  organizations Organization[]
  invoices      Invoice[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
  @@index([createdAt])
}

model Deal {
  id          String    @id @default(cuid())
  salesId     String    @unique // e.g. SAL-1234
  title       String
  description String?   @db.Text
  amountEur   Decimal?  @db.Decimal(14, 2)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pipelineId  String
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id])
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id])
  ownerId     String?
  owner       User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Manual ordering within a kanban column.
  boardOrder  Int       @default(0)
  dueDate     DateTime?
  closedAt    DateTime?
  // Soft-delete marker: non-null means the deal is hidden from all views but
  // retained in the database. Never hard-deleted via the UI.
  deletedAt   DateTime?
  tags        Tag[]     @relation("DealTags")
  tasks       Task[]
  comments    Comment[]
  attachments Attachment[]
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
  @@index([ownerId])
  @@index([stageId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Task {
  id          String     @id @default(cuid())
  dealId      String
  deal        Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title       String
  type        TaskType    @default(TASK)
  status      TaskStatus  @default(OPEN)
  urgency     TaskUrgency @default(MEDIUM)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([dealId])
  @@index([assigneeId])
  @@index([status])
  @@index([urgency])
}

model Comment {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  notifiedUserIds Json? // user ids explicitly notified for this comment, used to pre-select next time
  createdAt DateTime @default(now())

  @@index([dealId])
}

model Attachment {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  filename     String
  storageKey   String   // relative path inside UPLOADS_DIR
  size         Int      @default(0)
  mimeType     String?
  sourceUrl    String?  @db.Text // original Jira URL when imported
  // Inline images pasted/uploaded inside rich-text (comments). Kept out of the
  // Files list UI but served through the same access-checked attachments route.
  inline       Boolean  @default(false)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([dealId])
}

// ---------------------------------------------------------------------------
// Billing: organizations (legal entities) & invoices
// ---------------------------------------------------------------------------
// A billing legal entity (SRL/SA/LLC/etc.) that we issue invoices to. One CRM
// Client (the account/relationship) can own several Organizations.
model Organization {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Exact name as it appears in the source export ("Nume companie"). Used as the
  // idempotent join key for the invoice import (facturi "Nume companie (from Client)").
  sourceName String   @unique
  // Display/legal name (defaults to sourceName when not separately provided).
  legalName  String?
  country    String?
  // Romanian CUI / VAT id / EIN etc.
  taxId      String?
  // Romanian trade-register number ("J....").
  regNumber  String?
  bankName   String?
  iban       String?
  address    String?  @db.Text
  // Marks the default billing entity for its client.
  isDefault  Boolean  @default(false)
  // VAT percentage used when calculating tax for this organization.
  tvaPercent Decimal  @default(21.00) @db.Decimal(5, 2)

  // --- Romanian accounting / "tert" fields (exact export column names). ---
  // Some duplicate the canonical columns above (tara=country, adresa=address,
  // cont_banca=iban, banca=bankName, reg_com=regNumber) and are kept in sync on
  // write so legacy display/invoice code keeps working off the canonical ones.
  tara       String?
  judet      String?
  localitate String?
  adresa     String?  @db.Text
  cont_banca String?
  banca      String?
  tel        String?
  email      String?
  reg_com    String?
  delegat    String?
  inf_supl   String?  @db.Text
  tip_tert   String?
  is_tva     Boolean  @default(false)
  blocat     Boolean  @default(false)
  data_v_tva DateTime?
  data_s_tva DateTime?
  cod_post   String?

  invoices   Invoice[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@index([taxId])
}

// A seller/issuing legal entity that we issue invoices *from* (e.g. BIT SENTINEL
// SECURITY SRL, CYBEREDU SRL). Configured in Settings and offered in the invoice
// wizard. `name` mirrors the legacy free-text Invoice.issuerName so filtering and
// per-issuer totals work across both imported and manually-created invoices.
model Issuer {
  id         String    @id @default(cuid())
  // Display / legal name; also the join key against Invoice.issuerName.
  name       String    @unique
  legalName  String?
  // CUI / VAT id ("ClientCIF").
  taxId      String?
  // Trade-register number ("ClientNrRegCom" / reg_com).
  regCom     String?
  country    String?
  county     String?
  city       String?
  address    String?   @db.Text
  bankName   String?
  iban       String?
  phone      String?
  email      String?
  // Capital social, printed as "FurnizorCapital" in the Saga export.
  capital    String?
  // Free-text footer ("FurnizorInformatiiSuplimentare"), e.g. SWIFT/bank notes.
  infSupl    String?   @db.Text
  isDefault  Boolean   @default(false)
  isActive   Boolean   @default(true)
  invoices   Invoice[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Catalog of billable part-number templates (imported from the part-numbers
// matrix). The `code` is a template that may contain `<...>` placeholders (e.g.
// "RED-PEN-B-I-BP-<limit>"); the invoice wizard fills those in per invoice.
model PartNumber {
  id             String    @id @default(cuid())
  // Template code, e.g. "RED-PEN-B-I-BP-<limit>". Unique join/idempotency key.
  code           String    @unique
  group          String?
  title          String?   @db.Text
  // Human hint(s) describing each limit placeholder (comma-separated, in order).
  limitations    String?   @db.Text
  category       String?
  subCategory    String?
  subSubCategory String?
  type           String?
  description    String?   @db.Text
  order          Int       @default(0)
  active         Boolean   @default(true)
  invoices       Invoice[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([group])
}

// A self-managed invoice number series (e.g. prefix "BIT.R"). The CRM assigns
// FacturaNumar as "<prefix> <nextNumber>" and increments the counter the first
// time an invoice in the series is issued (XML download / accounting email).
model InvoiceSeries {
  id         String    @id @default(cuid())
  // Series code / prefix shown on the number, e.g. "BIT.R".
  prefix     String    @unique
  // Next number to assign; the admin seeds the initial value.
  nextNumber Int       @default(1)
  isDefault  Boolean   @default(false)
  isActive   Boolean   @default(true)
  invoices   Invoice[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Invoice {
  id             String        @id @default(cuid())
  // Source idempotency key: Airtable "Record ID" for imports, "manual-<cuid>" for
  // records created through the UI. Unique so re-imports update in place.
  externalRecordId String      @unique
  // Original request reference from the source export ("Referinta cerere").
  externalRef    String?
  // Human invoice number(s), e.g. "BT.BIT 696".
  number         String?
  status         InvoiceStatus @default(GENERATA)

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Denormalized owning client for convenient listing/filtering.
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Opportunity this invoice was issued under (via Deal.salesId). Nullable because
  // some invoices reference a SAL that is missing from the CRM, or none at all.
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  // Snapshot of the referenced SAL id (kept even when the deal can't be resolved).
  salesIdSnapshot String?

  servicesDescription String?   @db.Text
  // Best-effort contract reference parsed from the services text.
  contractRef    String?
  // Raw amount string from the source ("Suma"), kept verbatim for traceability.
  amountRaw      String?
  currency       String?
  paymentTermDays Int?
  issueDate      DateTime?
  // Date the invoice is expected/planned to be issued (manual scheduling).
  expectedInvoiceDate DateTime?
  // Whether the invoice has been paid by the client.
  paid           Boolean       @default(false)
  // Parsed numeric total of the invoice.
  totalAmount    Decimal?      @db.Decimal(14, 2)
  // Accounting export subtotal before VAT ("baza_tva").
  totalBaseAmount Decimal?     @db.Decimal(14, 2)
  // Accounting export VAT amount ("tva").
  vatAmount      Decimal?      @db.Decimal(14, 2)
  // VAT rate (%) locked on this invoice. Defaults from the org country rules but
  // can be overridden per invoice (e.g. foreign client billed with domestic VAT).
  vatPercent     Decimal?      @db.Decimal(5, 2)
  // Outstanding balance from accounting ("neachitat").
  unpaidAmount   Decimal?      @db.Decimal(14, 2)
  // Raw total string ("Total de pe factura"), kept verbatim.
  totalRaw       String?
  // Extra invoice-level accounting note from import ("inf_suplm").
  invoiceInfo    String?       @db.Text
  // Original imported invoice/header values, kept for hover/tooltips and audit.
  originalValues Json?
  // Newline-separated source document URLs ("Facturi").
  fileUrls       String?       @db.Text
  // Issuing company ("Factura se face pe"), typically the seller entity. Kept as
  // free text for imports; manual invoices also link a configured Issuer below.
  issuerName     String?
  issuerId       String?
  issuer         Issuer?       @relation(fields: [issuerId], references: [id], onDelete: SetNull)
  // Billable part number chosen for this invoice.
  partNumberId   String?
  partNumber     PartNumber?   @relation(fields: [partNumberId], references: [id], onDelete: SetNull)
  // Resolved code with the dynamic limits filled in, e.g. "RED-PEN-B-I-BP-50".
  partNumberCode String?
  // Placeholder -> value map for the chosen part number, e.g. { "limit": "50" }.
  partNumberValues Json?
  // When true, we generate the invoice ourselves and assign a FacturaNumar from
  // our own series on issue. Default false: the accounting firm generates it and
  // assigns the number, so we leave `number` empty until they report it back.
  selfIssued     Boolean       @default(false)
  // Invoice number series used to assign FacturaNumar when issuing (self-issued only).
  seriesId       String?
  series         InvoiceSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  // Optional link to a related invoice for the same customer (e.g. split project).
  relatedInvoiceId String?
  relatedInvoice   Invoice?    @relation("RelatedInvoice", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  relatedInvoices  Invoice[]   @relation("RelatedInvoice")
  createdByName  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  files          InvoiceFile[]
  lines          InvoiceLine[]

  @@index([organizationId])
  @@index([dealId])
  @@index([clientId])
  @@index([issueDate])
  @@index([issuerId])
  @@index([partNumberId])
  @@index([relatedInvoiceId])
  @@index([seriesId])
}

// Invoice articles/lines. Imported accounting exports repeat the same invoice
// number once per article, so the invoice stays grouped while lines preserve
// each row's service, quantity, unit, and original values.
model InvoiceLine {
  id                  String   @id @default(cuid())
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceLineKey       String?
  serviceDescription  String?  @db.Text
  textSupplement      String?  @db.Text
  unitOfMeasure       String?
  quantity            Decimal? @db.Decimal(14, 4)
  unitPrice           Decimal? @db.Decimal(14, 4)
  value               Decimal? @db.Decimal(14, 2)
  total               Decimal? @db.Decimal(14, 2)
  originalValues      Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([invoiceId, sourceLineKey])
  @@index([invoiceId])
}

// Issued invoice documents (PDFs) returned by accounting and stored locally.
// Served only to authenticated, authorized users via /api/invoices/files/[id].
model InvoiceFile {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String?
  size       Int      @default(0)
  // Path within UPLOADS_DIR (see src/lib/storage.ts).
  storageKey String
  // Provenance, e.g. "email-reply".
  source     String?
  createdAt  DateTime @default(now())

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Custom fields (admin configurable)
// ---------------------------------------------------------------------------
model CustomFieldDefinition {
  id        String          @id @default(cuid())
  entity    CustomEntity
  key       String // stable machine key, unique per entity
  label     String
  type      CustomFieldType @default(TEXT)
  options   Json? // for SELECT / MULTISELECT
  required  Boolean         @default(false)
  order     Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  values    CustomFieldValue[]

  @@unique([entity, key])
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entity       CustomEntity
  entityId     String
  value        Json?
  updatedAt    DateTime              @updatedAt

  @@unique([definitionId, entityId])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------
// Explicit share of a single deal/client to a user (admin granted).
model Share {
  id        String       @id @default(cuid())
  subject   ShareSubject
  subjectId String
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([subject, subjectId, userId])
  @@index([userId])
}

// Tag + date based visibility rule for a sales user.
model AccessRule {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null tag = applies to all tags (still bounded by visibleFrom)
  tagId       String?
  tag         Tag?      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  visibleFrom DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Sequence counters (e.g. SAL deal numbers).
model Counter {
  name  String @id
  value Int    @default(0)
}

// Generic app-level key/value settings (admin configurable, single-tenant).
// e.g. key="default_deal_owner_id" -> value=<userId>.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Audit + idempotency log for inbound lead emails received via webhook.
// `messageId` (e.g. the Gmail message id) is unique so retried/duplicate
// deliveries are recognized and skipped instead of creating duplicate deals.
model InboundLead {
  id        String   @id @default(cuid())
  messageId String   @unique
  fromAddr  String?
  subject   String?
  status    String // "created" | "duplicate" | "ignored" | "error"
  dealId    String?
  clientId  String?
  error     String?  @db.Text
  payload   String   @db.Text // raw JSON body as received
  createdAt DateTime @default(now())

  @@index([createdAt])
}
